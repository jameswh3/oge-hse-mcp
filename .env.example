# Azure deployment
AZURE_SUBSCRIPTION_ID=REPLACE-WITH-SUBSCRIPTION-ID
AZURE_TENANT_ID=REPLACE-WITH-TENANT-ID
AZURE_LOCATION=eastus2
AZURE_RESOURCE_GROUP=rg-oge-hse-mcp-dev
AZURE_ENVIRONMENT_NAME=dev
HSE_CONTAINER_IMAGE_TAG=latest

# Entra resource API
HSE_ENTRA_APP_DISPLAY_NAME=oge-hse-mcp-dev
HSE_ENTRA_TENANT_ID=REPLACE-WITH-TENANT-ID
HSE_ENTRA_AUDIENCE=REPLACE-AFTER-APP-REGISTRATION
HSE_ENTRA_ISSUER=https://login.microsoftonline.com/REPLACE-WITH-TENANT-ID/v2.0
HSE_ENTRA_RESOURCE_URL=https://REPLACE-WITH-CONTAINER-APP/mcp
HSE_ENTRA_SITE_CLAIM=site_ids
HSE_ENTRA_READ_SCOPES=hse.read
HSE_SOURCE_ITEM_BASE_URL=https://hse.example.invalid/records

# Copilot Studio custom connector with OBO OAuth
HSE_OBO_CONNECTOR_APP_DISPLAY_NAME=oge-hse-mcp-connector-dev
HSE_OBO_CONNECTOR_CLIENT_ID=REPLACE-AFTER-OBO-APP-PROVISIONING
HSE_OBO_CONNECTOR_CLIENT_SECRET=SET-LOCALLY-ONLY-IF-NOT-USING-MANAGED-IDENTITY
HSE_OBO_REDIRECT_URI=REPLACE-AFTER-CUSTOM-CONNECTOR-SAVE
HSE_OBO_MANAGED_IDENTITY_ISSUER=OPTIONAL-FROM-CUSTOM-CONNECTOR
HSE_OBO_MANAGED_IDENTITY_SUBJECT=OPTIONAL-FROM-CUSTOM-CONNECTOR

# Microsoft 365 federated connector tenant registration
HSE_FEDERATED_CONNECTOR_NAME=Example HSE Knowledge
HSE_FEDERATED_CONNECTOR_PUBLISHER=Example Organization
HSE_FEDERATED_CONNECTOR_REGISTRATION_ID=REPLACE-AFTER-MICROSOFT-OR-TENANT-REGISTRATION

# Runtime
HSE_DATABASE_URL=sqlite:////data/hse_demo.db
HSE_DEFAULT_SEARCH_LIMIT=10
HSE_MAX_SEARCH_LIMIT=50
HSE_REQUIRE_AUTH=true
HSE_MCP_TRANSPORT=streamable-http
FASTMCP_HOST=0.0.0.0
